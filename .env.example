# Pre-Visit Voice Agent - Environment Configuration Template
# ===========================================================
# PRODUCTION SETUP GUIDE:
# 1. Copy this file to .env and fill in your actual values
# 2. NEVER commit .env to version control - add it to .gitignore
# 3. Use environment variables or secrets management for production
# 4. Generate a strong SECRET_KEY: python -c "import secrets; print(secrets.token_hex(32))"
# 5. Rotate API keys regularly

# ============================================================================
# CRITICAL SECURITY SETTINGS
# ============================================================================

# Flask environment (MUST be "production" in production)
FLASK_ENV=production
FLASK_DEBUG=false

# Secret key for session management (generate a new one for production)
SECRET_KEY=your-generated-secret-key-here-change-immediately

# API key for protecting endpoints
API_KEY=your-secure-api-key-here

# ============================================================================
# LANGUAGE SUPPORT - INDIAN LANGUAGES
# ============================================================================

# Default language codes:
# en  = English
# hi  = Hindi
# mr  = Marathi
# te  = Telugu
# bn  = Bengali
# ta  = Tamil
# ml  = Malayalam
# kn  = Kannada

STT_LANGUAGE=hi
TTS_LANGUAGE=hi
DEFAULT_LANGUAGE=en

# ============================================================================
# LLM API KEYS (KEEP THESE SECRET - USE ENVIRONMENT VARIABLES IN PRODUCTION)
# ============================================================================

# OpenAI API Key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your_key_here

# Cartesia TTS API Key: https://cartesia.ai/
CARTESIA_API_KEY=sk_car_your_key_here

# Anthropic API Key (optional fallback): https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your_key_here

# ============================================================================
# LLM CONFIGURATION
# ============================================================================

LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.7

# ============================================================================
# SPEECH-TO-TEXT (STT) CONFIGURATION
# ============================================================================

STT_MODEL_SIZE=large-v3
STT_DEVICE=cpu  # Change to cuda if GPU available
STT_ENERGY_THRESHOLD=300
STT_DYNAMIC_ENERGY=false
STT_PAUSE_THRESHOLD=0.5
STT_PHRASE_TIME_LIMIT=5

# ============================================================================
# TEXT-TO-SPEECH (TTS) CONFIGURATION
# ============================================================================

TTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2
ENABLE_VOICE_CLONING=false
TTS_SPEAKER_WAV=voice_samples/mariam_voice.wav
ADD_NATURAL_PAUSES=true
PAUSE_AFTER_SENTENCE=0.05
PAUSE_AFTER_QUESTION=0.05
TTS_TAIL_SILENCE_SEC=0.35

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

ENVIRONMENT=production
APP_VERSION=1.0.0
PORT=5000
LOG_LEVEL=INFO
VERBOSE_LOGGING=false

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Development: SQLite
DATABASE_URL=sqlite:///./data/voice_agent.db

# Production: PostgreSQL (recommended)
# DATABASE_URL=postgresql://username:password@host:5432/previsit_agent

# Redis (optional - for caching)
# REDIS_URL=redis://localhost:6379/0

# ============================================================================
# FILE & DIRECTORY CONFIGURATION
# ============================================================================

DATA_DIR=./data
LOGS_DIR=./logs
OUTPUT_DIR=./output
VOICE_SAMPLE_PATH=voice_samples/mariam_voice.wav
SAVE_JSON=true
GENERATE_PDFS=true

# ============================================================================
# WEB SERVER & SECURITY
# ============================================================================

# Flask environment
FLASK_ENV=production
CORS_ORIGINS=http://localhost:3000,http://localhost:5000,https://yourdomain.com

# Gunicorn workers (typically 2-4 * CPU cores)
WORKERS=2
WORKER_TIMEOUT=120
MAX_CONTENT_LENGTH=104857600

# ============================================================================
# CONVERSATION & SESSION SETTINGS
# ============================================================================

MAX_CONVERSATION_TURNS=15
MAX_CONCURRENT_SESSIONS=10
AUDIO_BUFFER_SIZE=1024
EXTRACTION_INTERVAL=3
ENABLE_INTERRUPT_DETECTION=false

# ============================================================================
# AWS INTEGRATION (OPTIONAL)
# ============================================================================

# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# S3_BUCKET=your_bucket_name

# ============================================================================
# ERROR TRACKING & MONITORING (OPTIONAL)
# ============================================================================

# Sentry for error tracking
# SENTRY_DSN=https://your_sentry_url

# NewRelic monitoring
# NEW_RELIC_LICENSE_KEY=your_newrelic_key

# ============================================================================
# EHR INTEGRATION (OPTIONAL)
# ============================================================================

# EHR_API_URL=https://your-ehr-system.com/api
# EHR_API_KEY=your_ehr_api_key
# EHR_TIMEOUT=30

# ============================================================================
# EMAIL NOTIFICATIONS (OPTIONAL)
# ============================================================================

# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# SENDER_EMAIL=notifications@yourdomain.com

# ============================================================================
# JWT/AUTHENTICATION (OPTIONAL)
# ============================================================================

# JWT_EXPIRATION_HOURS=24
# JWT_ALGORITHM=HS256

# ============================================================================
# CAREBOT INTEGRATION (OPTIONAL)
# ============================================================================

# CAREBOT_WEBHOOK_URL=https://your-carebot.com/webhook
# CAREBOT_API_KEY=your_carebot_key
# CAREBOT_TIMEOUT=30

# ============================================================================
# DEVELOPMENT ONLY (NEVER USE IN PRODUCTION)
# ============================================================================

# DEBUG_MODE=false
# USE_MOCK_SERVICES=false
