# Pre-Visit Voice Agent - Environment Variables
# =============================================
# Copy this file to .env and fill in the actual values
# IMPORTANT: Never commit .env to version control!

# ============= FLASK CONFIG =============
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000
SECRET_KEY=your-secret-key-change-this-in-production

# ============= APPLICATION =============
APP_VERSION=1.0.0
ENVIRONMENT=production
LOG_LEVEL=INFO

# ============= API KEYS (Required) =============
# Get from OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Get from Cartesia: https://cartesia.ai/
CARTESIA_API_KEY=your-cartesia-api-key

# Set a strong API key for your endpoints
API_KEY=your-secure-api-key-here

# Optional: Anthropic API (fallback provider)
ANTHROPIC_API_KEY=sk-ant-your-actual-anthropic-api-key-here

# ============= DATABASE =============
# For development: SQLite (file-based)
DATABASE_URL=sqlite:///./conversations.db

# For production: PostgreSQL
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# ============= REDIS (Optional) =============
# For caching and task queues (requires separate Redis instance)
REDIS_URL=redis://localhost:6379/0

# ============= CORS & SECURITY =============
# Allowed origins for cross-origin requests (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5000,https://yourdomain.com

# ============= VOICE AGENT CONFIG =============
# Maximum conversation turns before auto-end
MAX_CONVERSATION_TURNS=50
MAX_TURNS=15

# Preferred language for responses (ar, en, hi)
DEFAULT_LANGUAGE=en

# STT Model Size (tiny, base, small, medium, large-v3)
STT_MODEL_SIZE=large-v3

# TTS Configuration
AGENT_NAME=Mariam
LLM_MODEL=gpt-4-turbo

# ============= OPTIONAL: ERROR TRACKING =============
# Sentry DSN for error monitoring
# SENTRY_DSN=https://your-sentry-url

# ============= OPTIONAL: AWS =============
# For file storage and backups
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_REGION=us-east-1

# ============= OPTIONAL: EMAIL NOTIFICATIONS =============
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# NOTIFICATION_EMAIL=admin@example.com

# ============= OPTIONAL: CareBot INTEGRATION =============
# CareBot Memory Agent API
# CAREBOT_API_URL=https://api.carebot.example.com
# CAREBOT_API_KEY=your-carebot-api-key

# ============= DEVELOPMENT ONLY =============
# Enable verbose logging
DEBUG_MODE=false

# Mock services for testing
USE_MOCK_SERVICES=false

# ============= RENDER DEPLOYMENT (Auto-set) =============
# These are automatically set by Render platform
# RENDER=true
# RENDER_SERVICE_ID=
# RENDER_INSTANCE_ID=
# RENDER_GIT_BRANCH=main
