# Environment Configuration Template
# ==================================
# Copy this file to .env and fill in your actual values

# =============================================================================
# REQUIRED: OpenAI API Configuration
# =============================================================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-actual-openai-api-key-here

# =============================================================================
# OPTIONAL: Fallback Provider (Anthropic)
# =============================================================================
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-actual-anthropic-api-key-here

# =============================================================================
# Application Environment
# =============================================================================
# Options: development, staging, production
ENVIRONMENT=development

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# =============================================================================
# OPTIONAL: Database Configuration (Future Use)
# =============================================================================
# PostgreSQL connection string
# DATABASE_URL=postgresql://username:password@localhost:5432/voice_agent

# Redis connection string (for caching and queues)
# REDIS_URL=redis://localhost:6379/0

# =============================================================================
# OPTIONAL: CareBot Integration (Future Use)
# =============================================================================
# CareBot Memory Agent API
# CAREBOT_API_URL=https://api.carebot.example.com
# CAREBOT_API_KEY=your-carebot-api-key

# =============================================================================
# OPTIONAL: Custom Settings
# =============================================================================
# Override default settings if needed

# STT Model Size (tiny, base, small, medium, large-v3)
# STT_MODEL_SIZE=large-v3

# TTS Voice Sample Path
# TTS_SPEAKER_WAV=./voice_samples/egyptian_receptionist.wav

# LLM Model Name
# LLM_MODEL=gpt-4o-mini

# Agent Name
# AGENT_NAME=Mariam

# Maximum Conversation Turns
# MAX_TURNS=15
